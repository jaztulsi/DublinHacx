# Supabase — client (exposed to browser via VITE_ prefix)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=

# Supabase — server only (never prefix with VITE_)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Service role key used by server functions in src/functions/registrations.functions.ts
SUPABASE_SERVICE_ROLE_KEY=

# Admin dashboard password (src/routes/admin.tsx)
ADMIN_PASSWORD=

# Vercel deployment — forces SSR build mode (also set in vercel.json)
VITE_TARGET=vercel

# Resend transactional email (server-only)
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@dublinHacx.com

# Registration passcode (server-only, prevents public spam signups)
REGISTRATION_PASSCODE=
